{
  "id": "cafe",
  "title": "咖啡廳",
  "titleEn": "The Café",
  "chunks": [
    {
      "id": "can_i_get",
      "en": "Can I get a latte, please?",
      "zh": "可以給我一杯拿鐵嗎？",
      "accept": ["Can I get a latte?"],
      "note": "Can I get…? 是點餐最常用的說法，比 I want… 有禮貌。",
      "distractors": [
        { "text": "Can I get latte, please?", "error": "article" },
        { "text": "I want latte.", "error": "other" }
      ]
    },
    { "id": "for_here", "en": "For here or to go?", "zh": "內用還是外帶？" },
    { "id": "to_go", "en": "To go, please.", "zh": "外帶，謝謝。", "accept": ["To go."] },
    { "id": "how_much", "en": "How much is it?", "zh": "這多少錢？" },
    {
      "id": "say_again",
      "en": "Sorry, can you say that again?",
      "zh": "不好意思，可以再說一次嗎？",
      "note": "聽不懂時最有用的一句，不用不好意思。"
    },
    { "id": "here_you_go", "en": "Here you go.", "zh": "給你。（遞東西時說）" },
    {
      "id": "iced_coffee",
      "en": "Can I get an iced coffee?",
      "zh": "可以給我一杯冰咖啡嗎？",
      "accept": ["Can I get an iced coffee, please?"],
      "note": "冰咖啡是 iced coffee（加了冰的咖啡）。iced 開頭是母音，所以用 an。",
      "distractors": [
        { "text": "Can I get a iced coffee?", "error": "article" },
        { "text": "Can I get an iced coffees?", "error": "plural" },
        { "text": "Can I get an coffee iced?", "error": "word-order" }
      ]
    },
    {
      "id": "no_sugar",
      "en": "No sugar, please.",
      "zh": "不加糖，謝謝。",
      "accept": ["No sugar.", "No sugar please."],
      "note": "No + 東西 = 不要加那個東西。",
      "distractors": [
        { "text": "No sugars, please.", "error": "plural" },
        { "text": "Not sugar, please.", "error": "other" }
      ]
    },
    {
      "id": "what_sizes",
      "en": "What sizes do you have?",
      "zh": "有哪幾種大小？",
      "note": "問有哪些可以選，用複數 sizes；do 不能省。",
      "distractors": [
        { "text": "What sizes you have?", "error": "missing-word" },
        { "text": "What sizes have you do?", "error": "word-order" },
        { "text": "What sizes do you has?", "error": "other" }
      ]
    },
    {
      "id": "small_one",
      "en": "A small one, please.",
      "zh": "小杯的，謝謝。",
      "accept": ["A small one."],
      "note": "one 代替前面說過的東西（這裡是飲料），不用再說一次 latte。",
      "distractors": [
        { "text": "An small one, please.", "error": "article" },
        { "text": "A one small, please.", "error": "word-order" },
        { "text": "A small ones, please.", "error": "plural" }
      ]
    },
    {
      "id": "wifi_here",
      "en": "Is there Wi-Fi here?",
      "zh": "這裡有 Wi-Fi 嗎？",
      "accept": ["Is there wifi here?", "Is there WiFi here?", "Is there Wi-Fi?"],
      "note": "Is there…? 問「有沒有」。中文說「這裡有」，英文不說 Here has，要說 There is。",
      "distractors": [
        { "text": "Is there a Wi-Fi here?", "error": "article" },
        { "text": "There is Wi-Fi here?", "error": "word-order" },
        { "text": "Is here have Wi-Fi?", "error": "other" }
      ]
    },
    {
      "id": "table_outside",
      "en": "Is there a table outside?",
      "zh": "外面有桌子嗎？",
      "note": "一張桌子用 Is there a table…?；很多張用 Are there tables…?",
      "distractors": [
        { "text": "Is there table outside?", "error": "article" },
        { "text": "Are there a table outside?", "error": "other" },
        { "text": "Is there outside a table?", "error": "word-order" }
      ]
    },
    {
      "id": "seat_taken",
      "en": "Is this seat taken?",
      "zh": "這個位子有人坐嗎？",
      "note": "固定說法，整句記起來。taken 表示「已經有人坐了」。",
      "distractors": [
        { "text": "Is this seat take?", "error": "other" },
        { "text": "This seat is taken?", "error": "word-order" },
        { "text": "Is this seat is taken?", "error": "extra-word" }
      ]
    },
    {
      "id": "go_ahead",
      "en": "No, go ahead.",
      "zh": "沒有，請坐。",
      "accept": ["No. Go ahead.", "No, go ahead!"],
      "note": "回答 Is this seat taken?（有人坐嗎？）時，No 表示沒人坐。go ahead = 請便、請用。",
      "distractors": [
        { "text": "Yes, go ahead.", "error": "other" },
        { "text": "No, go a head.", "error": "spelling" },
        { "text": "No, ahead go.", "error": "word-order" }
      ]
    }
  ],
