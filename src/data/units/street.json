      "note": "where's = where is。向路人問地方在哪裡，先說 Excuse me 再問。",
      "distractors": [
        { "text": "Excuse me, where the bus stop?", "error": "missing-word" },
        { "text": "Excuse me, where's bus stop?", "error": "article" },
        { "text": "Excuse me, where's the stop bus?", "error": "word-order" }
      ]
    },
    {
      "id": "far_from_here",
      "en": "Is it far from here?",
      "zh": "離這裡遠嗎？",
      "accept": ["Is it far?"],
      "note": "far from here = 離這裡很遠。問到地方之後，常接著問這一句。",
      "distractors": [
        { "text": "Is far from here?", "error": "missing-word" },
        { "text": "Is it from far here?", "error": "word-order" },
        { "text": "Is it far from hear?", "error": "spelling" }
      ]
    },
    {
      "id": "which_way",
      "en": "Which way is the station?",
      "zh": "車站往哪邊走？",
      "accept": ["Excuse me, which way is the station?", "Which way is the station, please?"],
      "note": "Which way…? 問「往哪個方向走」。which 是「哪一個」。",
      "distractors": [
        { "text": "Which way the station is?", "error": "word-order" },
        { "text": "Which way is station?", "error": "article" },
        { "text": "Witch way is the station?", "error": "spelling" }
      ]
    },
    {
      "id": "left_or_right",
      "en": "Left or right?",
      "zh": "左邊還是右邊？",
      "accept": ["Right or left?"],
      "note": "A or B? 請對方二選一。right 在這裡是「右邊」，不是「對的」。",
      "distractors": [
        { "text": "Left and right?", "error": "other" },
        { "text": "Or left right?", "error": "word-order" },
        { "text": "Left or write?", "error": "spelling" }
      ]
    },
    {
      "id": "need_coins",
      "en": "I need some coins for the bus.",
      "zh": "我需要一些零錢搭公車。",
      "accept": ["I need coins for the bus.", "For the bus, I need some coins."],
      "note": "some 用在肯定句：有一些，不說幾個。後面可以數的東西用複數（coins）。",
      "distractors": [
        { "text": "I need some coin for the bus.", "error": "plural" },
        { "text": "I need any coins for the bus.", "error": "other" },
        { "text": "I need some coins for bus.", "error": "article" }
      ]
    },
    {
      "id": "any_change",
      "en": "Do you have any change?",
      "zh": "你有零錢嗎？",
      "accept": ["Do you have change?", "Do you have some change?"],
      "note": "any 用在問句和否定句（肯定句用 some）。change 當「零錢」時不加 s。",
      "distractors": [
        { "text": "Do you have any changes?", "error": "plural" },
        { "text": "Do you have a change?", "error": "article" },
        { "text": "Does you have any change?", "error": "other" }
      ]
    },
    {
      "id": "go_downtown",
