      "zh": "這是我要下的站嗎？",
      "accept": ["Excuse me, is this my stop?"],
      "note": "my stop = 我要下車的那一站。不確定到站了沒，就這樣問司機。",
      "distractors": [
        { "text": "Is my this stop?", "error": "word-order" },
        { "text": "Is this me stop?", "error": "other" },
        { "text": "Is this my stops?", "error": "plural" }
      ]
