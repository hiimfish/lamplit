  "tasks": [
    {
      "id": "t1",
      "title": "辦借書證",
      "titleEn": "Getting a library card",
      "newChunkIds": ["get_library_card", "live_near_here"],
      "newWordIds": ["librarian", "place", "until", "eleven", "twelve"],
      "scene": [
        {
          "id": "t1_1",
          "role": "guide",
          "speaker": "player",
          "en": "I'd like to get a library card.",
          "zh": "我想辦一張借書證。",
          "chunkId": "get_library_card"
        },
        {
          "id": "t1_2",
          "role": "librarian",
          "speaker": "npc",
          "en": "Of course. Do you live in the city?",
          "zh": "沒問題。你住在本市嗎？",
          "stage": {
            "act": "ask"
          }
        },
        {
          "id": "t1_3",
          "role": "guide",
          "speaker": "player",
          "en": "I live near here.",
          "zh": "我住在這附近。",
          "chunkId": "live_near_here"
        },
        {
          "id": "t1_4",
          "role": "librarian",
          "speaker": "npc",
          "en": "Great. Then I just need an ID with your address.",
          "zh": "好的。那我只需要一張有你地址的證件。"
        },
        {
          "id": "t1_5",
          "role": "librarian",
          "speaker": "npc",
          "en": "Here's your card. I'm Helen, one of the librarians.",
          "zh": "這是你的借書證。我是 Helen，這裡的館員。"
        },
        {
          "id": "t1_6",
          "role": "librarian",
          "speaker": "npc",
          "en": "We're open every day. On Sundays, it's eleven until four.",
          "zh": "我們每天都有開。星期天是十一點開到四點。"
        }
      ]
    },
    {
      "id": "t2",
      "title": "找書、借書",
      "titleEn": "Finding and borrowing books",
      "newChunkIds": ["where_computer_books", "how_many_borrow"],
      "newWordIds": ["magazine", "through", "under", "behind", "author", "title"],
      "fills": [
        {
          "id": "borrow_form",
          "en": "How many books can I ___?",
          "zh": "我一次可以借幾本書？",
          "options": ["borrow", "borrows", "borrowing"],
          "answer": 0,
          "note": "can 後面接動詞原形。",
          "chunkId": "how_many_borrow"
        },
        {
          "id": "who_author",
          "en": "Who is the ___ of this book?",
          "zh": "這本書的作者是誰？",
          "options": ["title", "author", "place"],
          "answer": 1,
          "note": "Who 問的是人，寫書的人是 author。"
        }
      ],
      "scene": [
        {
          "id": "t2_1",
          "role": "guide",
          "speaker": "player",
          "en": "Where are the computer books?",
          "zh": "電腦的書在哪裡？",
          "chunkId": "where_computer_books"
        },
        {
          "id": "t2_2",
          "role": "librarian",
          "speaker": "npc",
          "en": "Just through that door, behind the magazines.",
          "zh": "穿過那扇門就是了，在雜誌後面。",
          "stage": {
            "act": "want",
            "item": "magazine"
          }
        },
        {
          "id": "t2_3",
          "role": "librarian",
          "speaker": "npc",
          "en": "You can look up a title or author on this computer.",
          "zh": "你也可以用這台電腦查書名或作者。"
        },
        {
          "id": "t2_4",
          "role": "guide",
          "speaker": "player",
          "en": "How many books can I borrow?",
          "zh": "我一次可以借幾本？",
          "chunkId": "how_many_borrow"
        },
        {
          "id": "t2_5",
          "role": "librarian",
          "speaker": "npc",
          "en": "Up to twelve, for two weeks.",
          "zh": "最多十二本，可以借兩個禮拜。"
        },
        {
          "id": "t2_6",
          "role": "librarian",
          "speaker": "npc",
          "en": "But you can't take the magazines home.",
          "zh": "不過雜誌不能帶回家喔。"
        }
      ]
    },
    {
      "id": "t3",
      "title": "續借",
      "titleEn": "Renewing a book",
      "newChunkIds": ["renew_these_books", "didnt_have_time_read"],
      "newWordIds": ["renew", "due", "ago", "still", "remember", "forget"],
      "scene": [
        {
          "id": "t3_1",
          "role": "guide",
          "speaker": "player",
          "en": "Can I renew these books?",
          "zh": "這些書可以續借嗎？",
          "chunkId": "renew_these_books"
        },
        {
          "id": "t3_2",
          "role": "librarian",
          "speaker": "npc",
          "en": "Let me see. You borrowed them two weeks ago.",
          "zh": "我看一下。你是兩個禮拜前借的。"
        },
        {
          "id": "t3_3",
          "role": "librarian",
          "speaker": "npc",
          "en": "They're due today. Did you like them?",
          "zh": "今天到期。好看嗎？",
          "stage": {
            "act": "ask"
          }
        },
        {
          "id": "t3_4",
          "role": "guide",
          "speaker": "player",
          "en": "I didn't have time to read them.",
          "zh": "我還沒時間看。",
          "chunkId": "didnt_have_time_read"
        },
        {
          "id": "t3_5",
          "role": "librarian",
          "speaker": "npc",
          "en": "That's okay. You can keep them for two more weeks.",
          "zh": "沒關係。你可以再借兩個禮拜。"
        },
        {
          "id": "t3_6",
          "role": "librarian",
          "speaker": "npc",
          "en": "And if you forget, you can renew them online.",
          "zh": "如果你忘了，也可以上網續借。"
        }
      ]
    },
