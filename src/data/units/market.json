    {
      "id": "where_apples",
      "en": "Excuse me, where are the apples?",
      "zh": "不好意思，蘋果在哪裡？",
      "accept": ["Where are the apples?"],
      "note": "在店裡找不到東西時，用 Excuse me 開口問店員。apples 是複數，所以用 are。",
      "distractors": [
        { "text": "Excuse me, where is the apples?", "error": "plural" },
        { "text": "Excuse me, where the apples are?", "error": "word-order" },
        { "text": "Excuse me, where are the apple?", "error": "plural" }
      ]
    },
    {
      "id": "i_see_them",
      "en": "Thanks, I see them.",
      "zh": "謝謝，我看到了。",
      "accept": ["Thank you, I see them.", "Thanks, I see them now."],
      "note": "找到東西時這樣回答。them 指剛剛說的那些東西（複數）；只有一個時說 I see it。",
      "distractors": [
        { "text": "Thanks, I see they.", "error": "other" },
        { "text": "Thanks, I them see.", "error": "word-order" },
        { "text": "Thanks, I am see them.", "error": "extra-word" }
      ]
    },
    {
      "id": "try_one",
      "en": "Can I try one?",
      "zh": "我可以試吃一個嗎？",
      "accept": ["Can I try one, please?", "Could I try one?"],
      "note": "想試吃、試用時說。one 代替前面說的東西，不用再說一次名字。",
      "distractors": [
        { "text": "Can I try a one?", "error": "article" },
        { "text": "Can I one try?", "error": "word-order" },
        { "text": "Can I trying one?", "error": "other" }
      ]
    },
    {
      "id": "looks_good",
      "en": "This looks really good.",
      "zh": "這看起來很好吃。",
      "accept": ["It looks really good.", "This looks so good."],
      "note": "look + 形容詞 = 看起來…。主詞是 this，所以 look 要加 s；really 放在 good 前面加強語氣。",
      "distractors": [
        { "text": "This look really good.", "error": "other" },
        { "text": "This really good looks.", "error": "word-order" },
        { "text": "This is looks really good.", "error": "extra-word" }
      ]
    },
    {
      "id": "rice_and_eggs",
      "en": "I need some rice and some eggs.",
      "zh": "我需要一些米和一些蛋。",
      "accept": ["I need some rice and eggs."],
      "note": "rice 不可數：不加 s，也不說 a rice。egg 可數：兩個以上加 s。some 兩種都可以用。",
      "distractors": [
        { "text": "I need some rices and some eggs.", "error": "plural" },
        { "text": "I need some rice and some egg.", "error": "plural" },
        { "text": "I need a rice and some eggs.", "error": "article" }
      ]
    },
    {
      "id": "two_bottles",
      "en": "Two bottles of water, please.",
      "zh": "兩瓶水，謝謝。",
      "accept": ["Two bottles of water.", "Can I get two bottles of water, please?"],
      "note": "water 不可數，要數的時候數瓶子：a bottle of water、two bottles of water。s 加在 bottle 上。",
      "distractors": [
        { "text": "Two bottle of water, please.", "error": "plural" },
        { "text": "Two bottles of waters, please.", "error": "plural" },
        { "text": "Two bottles water, please.", "error": "missing-word" }
