  "titleEn": "Moving In",
  "chunks": [
    {
      "id": "just_moved_in",
      "en": "Yes, I just moved in.",
      "zh": "對，我剛搬進來。",
      "accept": ["I just moved in."],
      "note": "just + 過去式 = 剛剛才做了某件事。",
      "distractors": [
        { "text": "Yes, I just move in.", "error": "other" },
        { "text": "Yes, I just moved.", "error": "missing-word" }
      ]
    },
    {
      "id": "nice_to_meet_you",
      "en": "Nice to meet you.",
      "zh": "很高興認識你。",
      "distractors": [{ "text": "Nice meet you.", "error": "missing-word" }]
    },
    {
      "id": "from_taiwan",
      "en": "I'm from Taiwan.",
      "zh": "我來自台灣。",
      "accept": ["I am from Taiwan."],
      "note": "I'm = I am。說從哪裡來，要用 from。",
      "distractors": [
        { "text": "I from Taiwan.", "error": "missing-word" },
        { "text": "I'm come from Taiwan.", "error": "extra-word" }
      ]
    },
    {
      "id": "spell_that",
      "en": "How do you spell that?",
      "zh": "那個怎麼拼？",
      "note": "聽不懂名字時很好用，對方會一個字母一個字母念給你聽。",
      "distractors": [
        { "text": "How you spell that?", "error": "missing-word" },
        { "text": "How do you spell it that?", "error": "extra-word" }
      ]
    },
    {
      "id": "more_slowly",
      "en": "Can you speak more slowly, please?",
      "zh": "可以請你說慢一點嗎？",
      "accept": ["Can you speak more slowly?"],
      "note": "slowly 是「慢慢地」，用來說「怎麼」說話。",
      "distractors": [
        { "text": "Can you speak more slow, please?", "error": "other" },
        { "text": "Can you more slowly speak, please?", "error": "word-order" }
      ]
    },
    {
      "id": "got_it",
      "en": "Got it. Thanks!",
      "zh": "了解，謝謝！",
      "accept": ["Got it, thanks!"],
      "note": "Got it. 是口語的「懂了／知道了」。"
    },
    {
      "id": "help_with_box",
      "en": "Can you help me with this box?",
      "zh": "可以幫我搬這個箱子嗎？",
      "accept": ["Can you help me with this box, please?"],
      "note": "help + 人 + with + 東西 = 幫某人處理某樣東西。",
      "distractors": [
        { "text": "Can you help me this box?", "error": "missing-word" },
        { "text": "Can you help I with this box?", "error": "other" },
        { "text": "You can help me with this box?", "error": "word-order" }
      ]
    },
    {
      "id": "sure_no_problem",
      "en": "Sure, no problem.",
      "zh": "好啊，沒問題。",
      "accept": ["No problem."],
      "note": "別人請你幫忙時的回答。Sure 是口語的「好啊」。",
      "distractors": [
        { "text": "Sure, no problems.", "error": "plural" },
        { "text": "Sure, not problem.", "error": "other" },
        { "text": "Sure, problem no.", "error": "word-order" }
      ]
    },
    {
      "id": "live_alone",
      "en": "Yes, I live alone.",
      "zh": "對，我一個人住。",
      "accept": ["I live alone."],
      "note": "現在簡單式說平常的事。I live 不加 -s；he lives 才加。",
      "distractors": [
        { "text": "Yes, I living alone.", "error": "other" },
        { "text": "Yes, I lives alone.", "error": "other" },
        { "text": "Yes, I live in alone.", "error": "extra-word" }
      ]
    },
    {
      "id": "no_car",
      "en": "No, I don't have a car.",
      "zh": "沒有，我沒有車。",
      "accept": ["No, I do not have a car.", "I don't have a car.", "I do not have a car."],
      "note": "I don't = I do not。don't 後面接動詞原形 have。",
