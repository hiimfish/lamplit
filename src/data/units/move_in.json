{
  "id": "move_in",
  "title": "搬家第一天",
  "titleEn": "Moving In",
  "chunks": [
    {
      "id": "just_moved_in",
      "en": "Yes, I just moved in.",
      "zh": "對，我剛搬進來。",
      "accept": ["I just moved in."],
      "note": "just + 過去式 = 剛剛才做了某件事。",
      "distractors": [
        { "text": "Yes, I just move in.", "error": "other" },
        { "text": "Yes, I just moved.", "error": "missing-word" }
      ]
    },
    {
      "id": "nice_to_meet_you",
      "en": "Nice to meet you.",
      "zh": "很高興認識你。",
      "distractors": [{ "text": "Nice meet you.", "error": "missing-word" }]
    },
    {
      "id": "from_taiwan",
      "en": "I'm from Taiwan.",
      "zh": "我來自台灣。",
      "accept": ["I am from Taiwan."],
      "note": "I'm = I am。說從哪裡來，要用 from。",
      "distractors": [
        { "text": "I from Taiwan.", "error": "missing-word" },
        { "text": "I'm come from Taiwan.", "error": "extra-word" }
      ]
    },
    {
      "id": "spell_that",
      "en": "How do you spell that?",
      "zh": "那個怎麼拼？",
      "note": "聽不懂名字時很好用，對方會一個字母一個字母念給你聽。",
      "distractors": [
        { "text": "How you spell that?", "error": "missing-word" },
        { "text": "How do you spell it that?", "error": "extra-word" }
      ]
    },
    {
      "id": "more_slowly",
      "en": "Can you speak more slowly, please?",
      "zh": "可以請你說慢一點嗎？",
      "accept": ["Can you speak more slowly?"],
      "note": "slowly 是「慢慢地」，用來說「怎麼」說話。",
      "distractors": [
        { "text": "Can you speak more slow, please?", "error": "other" },
        { "text": "Can you more slowly speak, please?", "error": "word-order" }
      ]
    },
    {
      "id": "got_it",
      "en": "Got it. Thanks!",
      "zh": "了解，謝謝！",
      "accept": ["Got it, thanks!"],
      "note": "Got it. 是口語的「懂了／知道了」。"
    }
  ],
  "words": [
    { "id": "key", "en": "key", "zh": "鑰匙", "emoji": "🔑" },
    { "id": "box", "en": "box", "zh": "箱子", "emoji": "📦" },
    { "id": "door", "en": "door", "zh": "門", "emoji": "🚪" },
    { "id": "chair", "en": "chair", "zh": "椅子", "emoji": "🪑" },
    { "id": "lamp", "en": "lamp", "zh": "檯燈", "emoji": "💡" },
    { "id": "trash_can", "en": "trash can", "zh": "垃圾桶", "emoji": "🗑️" }
  ],
  "pairs": [
    {
      "id": "fan_van",
      "focus": "f／v",
      "note": "兩個都是上排牙齒輕碰下唇。f 只吹氣；v 喉嚨要震動。",
      "a": { "id": "fan", "en": "fan", "zh": "電風扇" },
      "b": { "id": "van", "en": "van", "zh": "廂型車" }
    },
    {
      "id": "light_right",
      "focus": "l／r",
      "note": "l 舌尖頂住上排牙齒後面；r 舌頭往後捲，不碰到任何地方。",
      "a": { "id": "light", "en": "light", "zh": "燈" },
      "b": { "id": "right", "en": "right", "zh": "右邊" }
    },
    {
      "id": "bed_bad",
      "focus": "e／a",
      "note": "bad 的嘴巴比 bed 張得更大，嘴角往兩邊拉。",
      "a": { "id": "bed", "en": "bed", "zh": "床" },
      "b": { "id": "bad", "en": "bad", "zh": "不好的" }
    },
    {
      "id": "sink_think",
      "focus": "s／th",
      "note": "th 把舌尖輕輕放在上下牙齒中間吹氣；s 的舌頭留在牙齒後面。",
      "a": { "id": "sink", "en": "sink", "zh": "水槽" },
      "b": { "id": "think", "en": "think", "zh": "想" }
    },
    {
      "id": "ship_sheep",
      "focus": "短 i／長 ee",
      "note": "ship 短而放鬆；sheep 嘴角拉開，聲音拉長。",
      "a": { "id": "ship", "en": "ship", "zh": "船" },
      "b": { "id": "sheep", "en": "sheep", "zh": "綿羊" }
    },
    {
      "id": "cap_cup",
      "focus": "a／u",
      "note": "cap 嘴巴張大、嘴角往兩邊拉；cup 嘴巴微開放鬆，像短短的「阿」。",
      "a": { "id": "cap", "en": "cap", "zh": "帽子" },
      "b": { "id": "cup", "en": "cup", "zh": "杯子" }
    }
  ],
