      "note": "I'm = I am。形容詞 new 放在名詞 neighbor 前面。",
      "distractors": [
        { "text": "Hi, I your new neighbor.", "error": "missing-word" },
        { "text": "Hi, I'm your neighbor new.", "error": "word-order" },
        { "text": "Hi, I'm you new neighbor.", "error": "other" }
      ]
    },
    {
      "id": "whats_your_name",
      "en": "Sorry, what's your name?",
      "zh": "不好意思，你叫什麼名字？",
      "accept": ["Sorry, what is your name?", "What's your name?", "What is your name?"],
      "note": "what's = what is。沒聽清楚時，前面加 Sorry 比較客氣。",
