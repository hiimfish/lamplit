# Copy this file to .env and fill it in. Never commit .env.
# Only the scripts in scripts/ read it; the website itself needs no key.
#
# Google Cloud API key, restricted to the "Cloud Text-to-Speech API".
# Required only to generate pronunciation audio. Used by:
#   node --env-file=.env scripts/gen-audio.mjs   (pronunciation clips in public/audio/)
#   node --env-file=.env scripts/spike-tts.mjs   (voice comparison experiment)
GOOGLE_TTS_API_KEY=
