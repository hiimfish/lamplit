# Keep LF line endings in every checkout, on every OS, even when core.autocrlf is true
# (Git for Windows enables it by default). Prettier expects LF, so CRLF checkouts would
# make `npx prettier --check .` fail on every file.
* text=auto eol=lf

# Binary assets: never convert.
*.mp3 binary
*.woff2 binary
*.png binary
*.jpg binary
*.webp binary
# The pronunciation model (public/models/w2v2/model.q8.part*): raw bytes.
public/models/** binary
public/models/**/*.txt text eol=lf
